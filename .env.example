# Neon / PostgreSQL (required for Vercel — SQLite does not work on serverless)
# Pooled connection (from Neon dashboard → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection (from Neon dashboard → "Connection string", non-pooler)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local SQLite (optional — only if you change schema provider back to sqlite)
# DATABASE_URL="file:./dev.db"

# JWT secret — set a long random string in Vercel (required in production)
JWT_SECRET="heart-dev-secret-change-me-in-production"

# App URL (your Vercel deployment URL)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
