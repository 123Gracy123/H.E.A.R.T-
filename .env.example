# Database (SQLite)
DATABASE_URL="file:./dev.db"

# JWT secret — change in production
JWT_SECRET="heart-dev-secret-change-me-in-production"

# App URL (for PWA and auth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Mapbox token for enhanced maps (Leaflet works without it)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Push notifications (VAPID keys — generate for production)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
